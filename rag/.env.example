# rag/.env로 복사. 반드시 rag 폴더에서 실행하세요.
# 루트의 JDBC DATABASE_URL과 다릅니다! 비밀번호를 URL 인코딩하세요.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
# 루트 .env의 RAG_INTERNAL_TOKEN과 동일한 난수
RAG_INTERNAL_TOKEN=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_ENV=development
# 개발용 발췌 답변. 실제 AI는 openai, AI 사용 안 함은 degraded
RAG_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini
# migration의 vector(1536)과 반드시 일치
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.3
MAX_PAGES=200
