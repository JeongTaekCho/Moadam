# 원격 Supabase + 로컬 Spring 실행 기준. README의 "지금 해야 할 설정" 참고
# 이 파일을 .env로 복사한 뒤 YOUR_* 값을 입력하세요. 실제 값은 커밋 금지.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# API Keys > Legacy 탭의 service_role JWT (sb_secret_ 키로 대체하지 마세요)
SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
# ES256/RS256 프로젝트는 빈 값. 기존 HS256 프로젝트/로컬에서만 JWT secret 입력
SUPABASE_JWT_SECRET=
# SQL Editor 또는 Supabase CLI로 migration 적용 시 false 유지
FLYWAY_ENABLED=false
# Connect > Session pooler의 실제 HOST, 사용자명 복사. port 5432
DATABASE_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USER=postgres.YOUR_PROJECT_REF
# 원본 DB 비밀번호. 작은따옴표를 포함한 값은 shell quoting 규칙에 맞춰 입력
DATABASE_PASSWORD='YOUR_DATABASE_PASSWORD'
# Compose의 Python용 URL. 비밀번호 특수문자는 percent-encoding
RAG_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# 단독 실행 주소. Compose에서는 compose.yml이 http://rag:8000으로 덮어씁니다
RAG_URL=http://localhost:8000
# openssl rand -hex 32로 생성. rag/.env와 동일한 값 입력
RAG_INTERNAL_TOKEN=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
# 개발용 발췌 답변. 실제 AI는 openai, AI 사용 안 함은 degraded
RAG_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini
# migration의 vector(1536)과 반드시 일치
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.3
MAX_PAGES=200
