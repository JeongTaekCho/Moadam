# .env.local로 복사. Next 서버가 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# /api/v1을 붙이지 않습니다
BACKEND_URL=http://localhost:8080
# service_role / DB 비밀번호 / OpenAI 키는 이 파일에 넣지 않습니다

# 운영 가입 확인 메일의 복귀 주소. Vercel Production에 설정하세요.
# AUTH_SITE_URL=https://moadam.vercel.app

# 검색엔진 소유권 확인 meta 태그의 content 값만 입력 (HTML 전체 제외).
# 운영 환경에 설정 후 다시 배포하고 소유권 확인을 완료하세요.
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=
